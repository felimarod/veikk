[Unit]
Description=Veikk tablet service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/veikkd
Restart=on-failure
RestartSec=2
# Exit status 2: another veikkd already runs. Nothing to restart.
RestartPreventExitStatus=2

# The daemon only needs input devices, uinput, its own files and Hyprland's
# sockets, so take away the rest.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
