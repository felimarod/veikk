pkgname=veikk
pkgver=0.1.0
pkgrel=1
pkgdesc='Set up a Veikk drawing tablet: active area, pressure curve and pad buttons'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/veikk "$pkgdir/usr/bin/veikk"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/veikk.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/veikk.svg"
  install -Dm644 "$startdir/veikk.desktop" "$pkgdir/usr/share/applications/veikk.desktop"
  install -Dm644 "$startdir/veikk.service" "$pkgdir/usr/lib/systemd/user/veikk.service"
  install -Dm644 "$startdir/70-veikk.rules" "$pkgdir/usr/lib/udev/rules.d/70-veikk.rules"
}
