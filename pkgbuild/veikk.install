post_install() {
  udevadm control --reload 2>/dev/null || true
  udevadm trigger --subsystem-match=input --subsystem-match=misc --action=change 2>/dev/null || true
  echo ":: veikk: log out and back in once so your session gets access to the tablet (udev uaccess)."
  echo ":: Then open Veikk, or run: systemctl --user enable --now veikk.service"
}

post_upgrade() {
  post_install
  echo ":: veikk: restart the service to pick up the new version: systemctl --user restart veikk.service"
}

post_remove() {
  udevadm control --reload 2>/dev/null || true
}
